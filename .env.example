# Copy to .env. Never commit secrets. Database configuration is optional at startup.
APP_NAME=dayribbon API
CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
# Empty uses system CA certificates with hostname verification.
TIDB_SSL_CA=
# DeepL API key for foreign news translation (optional; empty disables translation).
DEEPL_API_KEY=
# Optional local DB override (no TiDB needed), e.g. sqlite:///data/dayribbon.db
DATABASE_URL=
# Signs dayribbon BI login tokens. Required in production: long random string.
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
# Optional OpenAI-compatible LLM for narrating verified numbers (empty = template narrative, no cost).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
