# ===== backend =====
# SQLite(개발/데모) — 기본값
DATABASE_URL=sqlite:///./data/dayribbon.db
# TiDB/MySQL 전환 시 (mysql+pymysql 드라이버 필요: pip install pymysql)
# DATABASE_URL=mysql+pymysql://user:password@host:4000/dayribbon?ssl_verify_cert=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_TTL_HOURS=168
AUTO_ANALYSIS_INTERVAL_SEC=120

# 데모 데이터 시드 / 데모 이벤트 라우터 — 실서비스에서는 반드시 0
SEED_DEMO=1
DEMO_EVENTS_ENABLED=1

# ===== LLM 분석 (미설정 시 규칙 기반 엔진으로 폴백) =====
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=

# ===== 외부 데이터 수집 API (미연결 — 인터페이스만 존재) =====
# EXIM_API_KEY=      # 한국수출입은행 환율
# ECOS_API_KEY=      # 한국은행 ECOS
# DART_API_KEY=      # DART 전자공시
# NEWS_API_KEY=      # 뉴스 수집

# ===== frontend =====
# vite dev proxy 대상
VITE_BACKEND_URL=http://localhost:8000
# 빌드 후 API 서버를 직접 호출할 때 (예: https://api.dayribbon.example)
# VITE_API_BASE=
