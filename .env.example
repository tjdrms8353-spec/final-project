# ===== backend =====
# 실행 환경: dev | production
# production에서는 DATABASE_URL에 mysql+pymysql:// 접속 정보가 필수이며
# 미설정·sqlite 지정 시 시작이 거부된다. 데모 시드/이벤트도 자동 비활성.
APP_ENV=dev

# SQLite(개발/데모) — 기본값
DATABASE_URL=sqlite:///./data/dayribbon.db
# TiDB/MySQL 전환 시 (pymysql 의존성 이미 포함)
# DATABASE_URL=mysql+pymysql://user:password@host:4000/dayribbon
# TiDB Cloud Serverless 예시 — certs/의 isrgrootx1.pem 사용 (Git 미포함, 각 PC/USB에 보관)
# DATABASE_URL=mysql+pymysql://2TLZXK92uie8inU.root:<비밀번호>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/dayribbon
# DB_SSL_CA=certs/isrgrootx1.pem
# CA 파일 없이 시스템 CA로 TLS 강제 — TiDB Serverless 등 TLS 필수 접속 시 1
# (Render 등 pem 파일이 없는 환경에서는 이 값으로 연결)
# DB_SSL_REQUIRED=1
# 커넥션 풀
# DB_POOL_SIZE=5
# DB_POOL_RECYCLE=300

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_TTL_HOURS=168
AUTO_ANALYSIS_INTERVAL_SEC=120

# 데모 데이터 시드 / 데모 이벤트 라우터 — production에서는 자동 0
SEED_DEMO=1
DEMO_EVENTS_ENABLED=1

# ===== LLM 분석 (미설정 시 규칙 기반 엔진으로 폴백) =====
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=

# ===== 외부 데이터 수집 (정식 전환 B 보완) =====
# EXIM_API_KEY=      # 한국수출입은행 환율 API (oapi.koreaexim.go.kr, 미설정 시 비활성)
# ECOS_API_KEY=      # 한국은행 ECOS (ecos.bok.or.kr, 미설정 시 비활성)
# FRED_API_KEY=      # FRED 연준 경제데이터 — 환율/미금리/유가 (fred.stlouisfed.org, 무료 키)
# EIA_API_KEY=       # EIA 에너지 데이터 — WTI 유가 (eia.gov, 무료 키)
# DART_API_KEY=      # OpenDART 기업 공시 (opendart.fss.or.kr, 무료 키)
# DART_CORP_CODES=   # 수집 대상 DART 고유번호, 쉼표 구분 (예: 00126380,00164779)
# NEWS_API_KEY=      # 뉴스 검색 API (RSS/GDELT 수집에는 불필요)

# GDELT 뉴스 수집 — 오픈 데이터, 키 불필요 (0이면 비활성)
# GDELT_ENABLED=1

# 이용 조건 미검증 공급처의 운영 활성화 스위치 — production에서
# license_verified=False인 수집기(현재 Google 뉴스 RSS)를 강제 실행할 때만 1.
# 각 공급처 이용 조건은 docs/DATA_LICENSES.md 참조.
# ALLOW_UNVERIFIED_SOURCES=0

# 수집 주기(초, 기본 6시간) / 요청 타임아웃(초)
# 수집기별 실제 주기는 collector_states 테이블에 저장되어 공급처 발표 주기로 관리됨
# COLLECT_INTERVAL_SEC=21600
# COLLECT_TIMEOUT_SEC=15

# 뉴스 RSS 수집 — API 키 없이 동작 (0이면 비활성)
# 주의: Google 뉴스 RSS는 상업적 이용 조건 불명확 → production 기본 비활성
# NEWS_COLLECT_ENABLED=1
# 쉼표로 여러 피드 지정 가능. 기본값: Google 뉴스 RSS (환율/수출입/원자재 검색)
# NEWS_RSS_URLS=https://news.google.com/rss/search?q=...&hl=ko&gl=KR&ceid=KR:ko

# ===== 알림 실발송 (정식 전환 D) =====
# 이메일 SMTP — 미설정 시 발송 큐가 '발송 대기(pending)'로 남고 설정 후 자동 발송
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587            # 465면 SMTP_SSL, 그 외 STARTTLS(SMTP_STARTTLS=1)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=               # 비워두면 SMTP_USER 사용
# SMTP_STARTTLS=1
# 카카오 알림톡 — 벤더 REST API (벤더마다 요청 형식이 달라 URL 주입 방식)
# KAKAO_API_URL=
# KAKAO_API_KEY=
# KAKAO_SENDER_KEY=
# 발송 재시도 상한 (기본 3, 초과 시 failed)
# DELIVERY_MAX_ATTEMPTS=3

# ===== 다중 PC 개발 =====
# 로컬 작업공간(venv·node_modules·빌드 산출물 설치 위치). 미설정 시
# Windows: C:\dayribbon-build, Linux/macOS: ~/dayribbon-local
# DAYRIBBON_LOCAL=C:\dayribbon-build

# ===== frontend =====
# vite dev proxy 대상
VITE_BACKEND_URL=http://localhost:8000
# 빌드 후 API 서버를 직접 호출할 때 (예: https://api.dayribbon.example)
# VITE_API_BASE=
